# Actual Budget Server Connection
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your-server-password
ACTUAL_BUDGET_ID=your-budget-sync-id

# AI Backend Selection
# Options: 'openai', 'google'
AI_BACKEND=openai

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google AI (Gemini) Configuration
# Get your API key from: https://aistudio.google.com/
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Local Data Storage
DATA_DIR=./data
SQLITE_DB_PATH=./data/assistant.db

# Server Configuration
PORT=3000
NODE_ENV=development

# Periodic Sync Configuration
# Interval in minutes for automatic sync (default: 360 = 6 hours)
SYNC_INTERVAL_MINUTES=360

# Job Timeout Configuration
# Fail jobs that exceed this runtime (minutes)
JOB_TIMEOUT_MINUTES=60
# How often to scan for timed out jobs (minutes)
JOB_TIMEOUT_CHECK_INTERVAL_MINUTES=5

# API Rate Limiting
# Window in milliseconds and max requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# API Base URL (UI)
VITE_API_BASE_URL=http://localhost:3000/api

# Legacy UI mode cannot expose the machine API. Enforced mode protects every API route.
AUTH_MODE=legacy
MACHINE_API_ENABLED=false
AUTH_ALLOWED_ORIGINS=
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=3600
# AUTH_CREDENTIALS_JSON is supplied by your secret manager: named reader/operator credentials.
# Startup still downloads/migrates/synchronizes the budget; never test against a real server.

# Disables scheduled background sync only; startup download/migration/sync still occurs.
SCHEDULED_SYNC_ENABLED=true

# Monthly report integrations are OFF by default. No sync/import is triggered by reports.
# Enabling AI explicitly authorizes sending allowlisted aggregate facts to AI_BACKEND.
# No transaction/payee/account/notes data is sent; no fallback to another provider.
REPORT_AI_ENABLED=false
# Requires existing credentials and an existing AUTH_ALLOWED_ORIGINS HTTPS origin.
REPORT_PUSH_ENABLED=false
REPORT_APP_ORIGIN=
REPORT_PUSH_TOKEN=
REPORT_PUSH_USER=
# Generates the prior calendar month in this timezone. Set currency before enabling.
REPORT_SCHEDULE_ENABLED=false
REPORT_CURRENCY=
REPORT_TIMEZONE=UTC
REPORT_SCHEDULE_DAY=2
REPORT_SCHEDULE_HOUR=8
